{
  "name": "luzmo-analyst-emailbot",
  "version": "1.0.0",
  "description": "Email bot that answers data questions via Luzmo /AIPrompt (agent: analyst) and replies with inline chart images",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@luzmo/nodejs-sdk": "^2.1.1",
    "dotenv": "^16.4.7",
    "imapflow": "^2.2.5",
    "mailparser": "^3.9.6",
    "nodemailer": "^10.0.15"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
