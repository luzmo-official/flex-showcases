# Mailbox the bot reads. Use an app password when the provider requires one.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=analyst-bot@company.com
IMAP_PASSWORD=your-mailbox-password
IMAP_MAILBOX=INBOX

# SMTP account used to send replies. Defaults to the IMAP user and password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=analyst-bot@company.com
SMTP_PASSWORD=your-mailbox-password
# Optional display name. Defaults to IMAP_USER.
SMTP_FROM="Luzmo Analyst <analyst-bot@company.com>"

# Comma-separated dataset IDs pinned for every /AIPrompt analyst call.
DATASET_IDS=dataset-id-1,dataset-id-2

# Luzmo API host (optional, defaults to https://api.luzmo.com)
LUZMO_HOST=https://api.luzmo.com

# Mint scoped embed tokens for /AIPrompt (recommended). Set to false to use org API keys directly.
AIPROMPT_USE_EMBED_AUTH=true
