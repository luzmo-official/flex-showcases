# Entra ID / Azure Bot credentials.
# MicrosoftAppPassword is the client secret VALUE, not the secret ID.
MicrosoftAppId=00000000-0000-0000-0000-000000000000
MicrosoftAppPassword=your-client-secret
MicrosoftAppType=SingleTenant
MicrosoftAppTenantId=00000000-0000-0000-0000-000000000000

# HTTP port for the Bot Framework messaging endpoint.
PORT=3978

# Public HTTPS origin of this bot (ngrok or dev tunnel), with no path.
# Required so Teams can load chart images from /charts/:id.
# Example: https://abc123.euw.devtunnels.ms
PUBLIC_BASE_URL=https://your-tunnel.example.com

# Comma-separated dataset IDs pinned for every /AIPrompt analyst call.
DATASET_IDS=dataset-id-1,dataset-id-2

# Luzmo API host (optional, defaults to https://api.luzmo.com)
LUZMO_HOST=https://api.luzmo.com

# Mint scoped embed tokens for /AIPrompt (recommended). Set to false to use org API keys directly.
AIPROMPT_USE_EMBED_AUTH=true
